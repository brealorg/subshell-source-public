<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- BACKUP03B_ANDROID_SYSTEM_BACKUP_DENY_ALL_V1 -->
    <!-- Deny every credential-protected Auto Backup domain. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />

    <!-- Deny every device-protected Auto Backup domain as defense-in-depth. -->
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />

    <!-- Historical predecessor-compatible explicit fences. -->
    <exclude domain="sharedpref" path="subshell_device_preferences.xml" />
    <exclude domain="database" path="subshell-offline-cache.db" />
    <exclude domain="database" path="subshell-offline-cache.db-shm" />
    <exclude domain="database" path="subshell-offline-cache.db-wal" />
</full-backup-content>
