<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          AUTH05E2 owns the release-only production App Link. The main manifest
          remains fail-closed for debug and manifest-fixture validation.
        -->
        <activity-alias
            android:name="app.subshell.prototype.auth.AuthProductionCallback"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="app.subshell.prototype.auth.AuthCallbackActivity"
            tools:node="replace">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="brealorg.github.io"
                    android:path="/oauth/callback"
                    android:scheme="https" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
