<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        Animated GIFs are deliberate functional fixtures for the media,
        gallery, quality-selection, and playback lifecycle contracts.
        Keep GifUsage enabled globally and ignore only these exact files.
    -->
    <issue id="GifUsage">
        <ignore path="app/src/main/res/drawable-nodpi/gif_high_quality.gif" />
        <ignore path="app/src/main/res/drawable-nodpi/gif_homemade.gif" />
        <ignore path="app/src/main/res/drawable-nodpi/gif_pixel_art.gif" />
        <ignore path="app/src/main/res/drawable-nodpi/pixel_gallery_campfire.gif" />
        <ignore path="app/src/main/res/drawable-nodpi/pixel_gallery_terminal.gif" />
        <ignore path="app/src/main/res/drawable-nodpi/pixel_gallery_cat.gif" />
        <ignore path="app/src/main/res/drawable-nodpi/pixel_gallery_moon.gif" />
    </issue>

    <!--
        Adaptive icons are platform resources introduced in API 26 and are
        intentionally kept in mipmap-anydpi-v26, matching Android guidance.
        minSdk 26 makes the generic ObsoleteSdkInt suggestion inapplicable.
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="app/src/main/res/mipmap-anydpi-v26" />
    </issue>
</lint>
